# Copy this file to ".env" and fill in real values.
PORT=3000

# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_EXPIRES_IN=1d

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_tracker

# Production only. Leave blank for local dev.
DB_SSL=false
# Comma-separated allowed frontend origins (my Vercel URL in production).
CLIENT_ORIGIN=

# Phase 2: Gmail auto-import. See docs/PHASE2.md for the full design.

# Where I send the browser after the Gmail OAuth callback (success or error).
CLIENT_URL=http://localhost:5173

# From a Google Cloud OAuth client (Testing mode, gmail.readonly scope only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Sign-in with Google (identity only -- "Continue with Google" on the login
# page). A SEPARATE flow from the Gmail import above, but the SAME OAuth
# client: add this as a second "Authorized redirect URI" on that client in
# Google Cloud Console (APIs & Services > Credentials > your OAuth client ID)
# alongside the gmail.readonly one -- no new client needed.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32-byte hex key for encrypting stored Gmail tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# ollama | gemini -- which extractApplication adapter to use.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# llama3.2:3b is smaller/faster than PHASE2.md's original llama3.1:8b pick --
# swap it back if you have the bandwidth/RAM to spare, same interface either way.
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
